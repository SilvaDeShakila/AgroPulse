# ====================================================================
# AgroPulse Enterprise Smart Agriculture Platform
# Environment Configuration Template (.env.example)
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI agricultural assistance features (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public base URL where this application is hosted.
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT="3000"

# Secret key used for signing and verifying JSON Web Tokens (HMAC-SHA256)
# REQUIRED in production: Generate a unique, cryptographically random secret of at least 32 characters (e.g. openssl rand -hex 32).
# Production mode will fail to start if this is missing, below 32 chars, or set to a placeholder.
JWT_SECRET="REPLACE_WITH_UNIQUE_CRYPTOGRAPHIC_32_CHAR_SECRET_HEX"

# Node environment ('development' | 'production')
NODE_ENV="development"

# --------------------------------------------------------------------
# PostgreSQL Relational Database Configuration
# --------------------------------------------------------------------
# DATABASE_URL: Standard PostgreSQL connection URI (PostgreSQL 14+ / 16+).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
# Example: postgresql://postgres:password@localhost:5432/agropulse
# NOTE: In production (NODE_ENV=production), this variable is required.
DATABASE_URL=""

# PGSSLMODE: Controls SSL connection mode ('disable' | 'require').
# Default: 'require' in production; 'disable' for local unencrypted PostgreSQL instances.
PGSSLMODE="disable"

# PGSSL_REJECT_UNAUTHORIZED: Set to 'true' to strictly verify SSL certificates,
# or 'false' for cloud-managed instances with self-signed certificate chains.
PGSSL_REJECT_UNAUTHORIZED="false"

# DB_POOL_MAX: Maximum number of concurrent connections in pg.Pool (default: 15).
DB_POOL_MAX="15"

# DB_TIMEOUT_MS: Maximum time in milliseconds to wait for connection acquisition (default: 5000).
DB_TIMEOUT_MS="5000"

# AUTO_MIGRATE: Set to 'true' to automatically execute pending schema migrations on server boot.
AUTO_MIGRATE="true"

# ALLOW_DISK_DB_FALLBACK: When set to 'true', allows development servers to use the
# local file storage engine at .data/agropulse_database.json if PostgreSQL is offline.
# WARNING: Keep 'false' in production to guarantee data durability in PostgreSQL.
ALLOW_DISK_DB_FALLBACK="true"
